generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketStatus {
  OPEN
  PAUSED
  CLOSED
  RESOLVED
}
enum OrderStatus {
  PENDING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}
enum OrderSide {
  BUY
  SELL
}
enum AuditActorType {
  USER
  SERVICE
  SYSTEM
}

model User {
  id String @id @default(cuid())
  email String? @unique
  displayName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallets Wallet[]
  venueAccounts VenueAccount[]
  orders Order[]
  positions Position[]
  auditLogs AuditLog[]
}
model Wallet {
  id String @id @default(cuid())
  userId String
  address String @unique
  chain String @default("solana")
  label String?
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Venue {
  id String @id @default(cuid())
  slug String @unique
  name String
  status String @default("unconfigured")
  createdAt DateTime @default(now())
  accounts VenueAccount[]
  markets Market[]
  orders Order[]
}
model VenueAccount {
  id String @id @default(cuid())
  userId String
  venueId String
  externalAccountId String?
  status String @default("unlinked")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id])
  @@unique([userId, venueId])
}
model CanonicalEvent {
  id String @id @default(cuid())
  title String
  description String?
  resolutionCriteria String?
  settlementSource String?
  startsAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  markets Market[]
}
model Market {
  id String @id @default(cuid())
  venueId String
  canonicalEventId String?
  externalId String
  title String
  description String?
  status MarketStatus @default(OPEN)
  currency String?
  expiresAt DateTime?
  resolutionCriteria String?
  lastSyncedAt DateTime?
  createdAt DateTime @default(now())
  venue Venue @relation(fields: [venueId], references: [id])
  canonicalEvent CanonicalEvent? @relation(fields: [canonicalEventId], references: [id])
  outcomes Outcome[]
  orders Order[]
  positions Position[]
  priceHistory PriceHistory[]
  @@unique([venueId, externalId])
  @@index([status, expiresAt])
}
model Outcome {
  id String @id @default(cuid())
  marketId String
  externalId String?
  label String
  sortOrder Int @default(0)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]
  positions Position[]
  @@index([marketId, sortOrder])
}
model Order {
  id String @id @default(cuid())
  userId String
  venueId String
  marketId String
  idempotencyKey String
  side OrderSide
  status OrderStatus @default(PENDING)
  requestedQuantity Decimal @db.Decimal(30, 12)
  limitPrice Decimal? @db.Decimal(18, 12)
  externalOrderId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])
  market Market @relation(fields: [marketId], references: [id])
  executions Execution[]
  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
}
model Execution {
  id String @id @default(cuid())
  orderId String
  externalExecutionId String?
  quantity Decimal @db.Decimal(30, 12)
  price Decimal @db.Decimal(18, 12)
  fee Decimal? @db.Decimal(18, 12)
  executedAt DateTime
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, executedAt])
}
model Position {
  id String @id @default(cuid())
  userId String
  marketId String
  outcomeId String
  quantity Decimal @db.Decimal(30, 12)
  averageEntryPrice Decimal @db.Decimal(18, 12)
  source String @default("estimated")
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])
  outcome Outcome @relation(fields: [outcomeId], references: [id])
  @@unique([userId, marketId, outcomeId])
}
model Transaction {
  id String @id @default(cuid())
  walletAddress String
  signature String? @unique
  chain String @default("solana")
  status String
  amount Decimal? @db.Decimal(30, 12)
  currency String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([walletAddress, createdAt])
}
model PriceHistory {
  id String @id @default(cuid())
  marketId String
  outcomeId String
  probability Decimal @db.Decimal(10, 8)
  volume Decimal? @db.Decimal(30, 12)
  observedAt DateTime
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcome Outcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  @@unique([outcomeId, observedAt])
  @@index([marketId, observedAt])
}
model AuditLog {
  id String @id @default(cuid())
  actorType AuditActorType
  actorId String?
  userId String?
  action String
  resourceType String
  resourceId String?
  requestId String?
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
}
